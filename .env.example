# Database (SQLite for local demo)
DATABASE_URL="file:./dev.db"

# NextAuth (required)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Optional: Microsoft Entra ID
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=

# Optional: Azure Document Intelligence
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Optional: Resend email
# RESEND_API_KEY=
# EMAIL_FROM="Finova <noreply@yourdomain.com>"

# Optional: Finnhub market quotes
# FINNHUB_API_KEY=
