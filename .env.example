# =============================================================================
# Finova environment template
# Copy to .env for local use. On Vercel, set the same keys in Project Settings.
# =============================================================================

# --- Database (REQUIRED) ---
# Production / cloud: Neon, Supabase, or Azure Postgres connection string
# Example Neon:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
#
# Local: use the same Neon free DB, or Docker:
#   docker run --name finova-pg -e POSTGRES_PASSWORD=finova -e POSTGRES_DB=finova -p 5432:5432 -d postgres:16
#   DATABASE_URL="postgresql://postgres:finova@localhost:5432/finova"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- NextAuth (REQUIRED) ---
# Local
NEXTAUTH_URL="http://localhost:3000"
# Production (set after first deploy to your real URL)
# NEXTAUTH_URL="https://your-app.vercel.app"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# --- Optional: Microsoft Entra ID ---
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=

# --- Optional: Azure Document Intelligence ---
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- Optional: email (Resend) ---
# RESEND_API_KEY=
# EMAIL_FROM="Finova <noreply@yourdomain.com>"

# --- Optional: market data ---
# FINNHUB_API_KEY=
